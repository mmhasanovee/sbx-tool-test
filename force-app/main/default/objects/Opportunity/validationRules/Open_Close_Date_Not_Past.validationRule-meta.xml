<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Open_Close_Date_Not_Past</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Setup.Automation_Settings__c.Bypass_All__c), NOT(IsClosed), CloseDate &lt; TODAY())</errorConditionFormula>
    <errorMessage>An open opportunity cannot have a close date in the past.</errorMessage>
</ValidationRule>
