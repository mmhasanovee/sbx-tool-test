<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Setup.Automation_Settings__c.Bypass_All__c), IsClosed, ISBLANK(TEXT(Reason)))</errorConditionFormula>
    <errorMessage>Select a Case Reason before closing the case.</errorMessage>
</ValidationRule>
